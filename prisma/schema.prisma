generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String
  name     String
  gender   String

  locale                        String  @default("ru")
  theme                         String  @default("dark")
  timeFormat                    String  @default("24h")
  dateFormat                    String  @default("dmy")
  weekStartsOn                  String  @default("monday")
  excludeRussianFiveTwoHolidays Boolean @default(false)

  createdAt DateTime @default(now())

  emailVerifiedAt           DateTime?
  emailVerificationDeadline DateTime?

  emailVerificationTokens EmailVerificationToken[]
  passwordRecoverToken    PasswordRecoverToken[]
  PasswordResetSession    PasswordResetSession[]
  tokenVersion            Int                      @default(0)
  memberships             OrganizationMember[]
  consents                ConsentRecord[]
  createdNotifications    Notification[]           @relation("NotificationCreatedBy")
  notificationRecipients  NotificationRecipient[]
}

model Employee {
  id           String  @id @default(cuid())
  name         String
  surname      String
  middlename   String
  email        String
  color        String
  sortOrder    Int     @default(0)
  salaryType   String?
  salaryAmount Float?

  positionId Int?
  position   Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])

  shifts     Shift[]
  vacations  Vacation[]
  bonusRules BonusRule[]

  @@unique([email, organizationId])
}

model Shift {
  id   String   @id @default(cuid())
  date DateTime

  employeeId     String?
  positionId     Int?
  organizationId Int

  allDay    Boolean @default(true)
  startTime Int?
  endTime   Int?

  organization Organization @relation(fields: [organizationId], references: [id])
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  position     Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
}

model Vacation {
  id             String   @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  note           String?
  employeeId     String
  organizationId Int

  employee     Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, startDate, endDate])
  @@index([employeeId, startDate, endDate])
}

model Position {
  id             Int     @id @default(autoincrement())
  name           String
  fullName       String
  organizationId Int
  color          String
  salaryType     String?
  salaryAmount   Float?

  organization Organization @relation(fields: [organizationId], references: [id])
  employees    Employee[]
  shifts       Shift[]
  bonusRules   BonusRule[]

  @@unique([organizationId, name])
}

model Organization {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String

  members     OrganizationMember[]
  positions   Position[]
  shifts      Shift[]
  employees   Employee[]
  vacations   Vacation[]
  bonusRules  BonusRule[]
  bonusMonths BonusMonth[]
}

model BonusRule {
  id             Int      @id @default(autoincrement())
  name           String
  scope          String
  formula        String
  organizationId Int
  positionId     Int?
  employeeId     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position     Position?    @relation(fields: [positionId], references: [id], onDelete: SetNull)
  employee     Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  months       BonusMonth[]

  @@index([organizationId, scope])
  @@index([positionId])
  @@index([employeeId])
}

model BonusMonth {
  id             Int      @id @default(autoincrement())
  month          String
  variables      Json
  ruleId         Int
  organizationId Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rule         BonusRule    @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([ruleId, month])
  @@index([organizationId, month])
}

model Role {
  id   Int    @id @default(autoincrement())
  name String @unique

  memberships OrganizationMember[]
}

model OrganizationMember {
  userId         String
  organizationId Int
  roleId         Int

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [roleId], references: [id])

  @@id([userId, organizationId])
  @@index([organizationId, roleId])
  @@index([roleId])
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String    @unique
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordRecoverToken {
  id        String    @id @default(cuid())
  userId    String
  codeHash  String
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model PasswordResetSession {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model Notification {
  id              String   @id @default(cuid())
  title           String
  message         String
  actionUrl       String?
  isGlobal        Boolean  @default(false)
  consentRequired Boolean  @default(false)
  consentType     String?
  consentVersion  String?
  createdAt       DateTime @default(now())
  createdById     String?

  createdBy      User?                   @relation("NotificationCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  recipients     NotificationRecipient[]
  checkboxes     NotificationCheckbox[]
  consentRecords ConsentRecord[]         @relation("NotificationConsent")

  @@index([createdAt])
}

model NotificationCheckbox {
  id             String  @id @default(cuid())
  notificationId String
  label          String
  sortOrder      Int     @default(0)
  required       Boolean @default(true)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId, sortOrder])
}

model NotificationRecipient {
  notificationId String
  userId         String
  readAt         DateTime?
  acceptedAt     DateTime?

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([notificationId, userId])
  @@index([userId, readAt])
}

model ConsentRecord {
  id             String   @id @default(cuid())
  userId         String
  consentType    String   @default("personal_data")
  version        String
  acceptedAt     DateTime @default(now())
  notificationId String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notification Notification? @relation("NotificationConsent", fields: [notificationId], references: [id], onDelete: SetNull)

  @@unique([userId, consentType, version])
  @@index([userId, consentType])
  @@index([notificationId])
}
